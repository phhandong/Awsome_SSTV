{
  "name": "awsome_sstv",
  "version": "1.0.0",
  "description": "Awesome SSTV — 浏览器内 SSTV 编解码静态站点",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "deploy:calendar": "npm exec --yes --package=wrangler@4.149.0 -- wrangler deploy",
    "vendor:tracking": "node scripts/vendor-tracking.mjs",
    "icons": "node scripts/build-icons.mjs",
    "prepare:offline": "node scripts/prepare-offline.mjs",
    "verify:offline": "node scripts/prepare-offline.mjs --check",
    "test:tracking": "node verify-tracking.js && node verify-satellite-catalog.mjs && node verify-tledata.mjs && node verify-orientation-auto.mjs && node verify-doppler.mjs && node verify-pass-calendar.mjs",
    "test:calendar": "node verify-pass-calendar.mjs",
    "test:calendar-browser": "node verify-tracking-browser.js --calendar-subscription",
    "test:pwa": "node verify-tracking-browser.js && node verify-satellite-catalog-browser.mjs",
    "test:doppler": "node verify-doppler.mjs",
    "test:field": "node verify-tracking-browser.js --doppler-ui",
    "test:tracking-layout": "node verify-tracking-layout.mjs",
    "test:recording-redecode": "node verify-recording-redecode.mjs",
    "verify": "node verify.js",
    "verify:dsp": "node verify-dsp.js",
    "verify:audio": "node verify-audio.js",
    "verify:security": "node verify-security.js",
    "verify:snr": "node verify-snr.js",
    "verify:robust": "node verify-robust.js",
    "verify:stream": "node verify-stream.js",
    "verify:multi": "node verify-multiframe.js",
    "test:catalog": "node verify-catalog.js",
    "test:ui": "node uitest.js && node verify-image-export.js",
    "test:browser": "node verify-browser.js",
    "test:real": "node verify-real.js",
    "test:real:pd": "node verify-pd-real.js",
    "test": "npm run verify:offline && npm run test:tracking && npm run test:catalog && npm run verify:audio && npm run verify:security && npm run verify:dsp && npm run verify:snr && npm run verify:stream && npm run verify:multi && npm run verify:robust && npm run verify && npm run test:ui && npm run test:recording-redecode && npm run test:real && npm run test:browser && npm run test:pwa",
    "dump:real": "node dump_result.js"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.25.12",
    "geomagnetism": "0.2.0",
    "jpeg-js": "^0.4.4",
    "jsdom": "^29.1.1",
    "mpg123-decoder": "^1.0.3",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "satellite.js": "6.0.1"
  }
}
